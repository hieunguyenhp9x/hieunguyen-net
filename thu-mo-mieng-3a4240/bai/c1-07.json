  "truyen": [
    {
      "en": "My father is a fisherman.",
      "vi": "Bố tôi là ngư dân."
    },
    {
      "en": "He works on a fishing boat with three other men.",
      "vi": "Bố cùng ba chú nữa đi chung một thuyền đánh cá."
    },
    {
      "en": "He leaves home at night and comes back in the morning.",
      "vi": "Bố rời nhà vào ban đêm và trở về vào buổi sáng."
    },
    {
      "en": "Sometimes the sea is rough, and he cannot go out.",
      "vi": "Có hôm biển động, bố không ra khơi được."
    },
    {
      "en": "My mother is a teacher at a primary school.",
      "vi": "Mẹ tôi là giáo viên tiểu học."
    },
    {
      "en": "She teaches the children to read and write.",
      "vi": "Mẹ dạy bọn trẻ đọc và viết."
    },
    {
      "en": "When I was a child, I went fishing with my father.",
      "vi": "Hồi nhỏ, tôi đi đánh cá cùng bố."
    },
    {
      "en": "I was not afraid of the sea.",
      "vi": "Tôi không sợ biển."
    },
    {
      "en": "My father says a big ship is very different from a fishing boat.",
      "vi": "Bố nói tàu lớn khác hẳn thuyền đánh cá."
    },
    {
      "en": "He wants me to work on big ships and have a better life.",
      "vi": "Bố muốn tôi làm việc trên tàu lớn và có cuộc sống tốt hơn."
    }

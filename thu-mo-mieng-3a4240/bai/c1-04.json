  "truyen": [
    {
      "en": "Nam is a third-year student.",
      "vi": "Nam là sinh viên năm thứ ba."
    },
    {
      "en": "He studies at Vietnam Maritime University in Hai Phong.",
      "vi": "Cậu học ở Đại học Hàng hải Việt Nam tại Hải Phòng."
    },
    {
      "en": "His major is navigation.",
      "vi": "Ngành của cậu là điều khiển tàu biển."
    },
    {
      "en": "Navigation students learn to navigate big ships.",
      "vi": "Sinh viên ngành này học cách điều khiển những con tàu lớn."
    },
    {
      "en": "They learn about maps of the sea. They are called charts.",
      "vi": "Họ học về bản đồ biển. Chúng được gọi là hải đồ."
    },
    {
      "en": "They also learn English, because ships use English.",
      "vi": "Họ cũng học tiếng Anh, vì tàu biển dùng tiếng Anh."
    },
    {
      "en": "Nam has classes five days a week.",
      "vi": "Nam học năm ngày một tuần."
    },
    {
      "en": "He likes his classes, but English is difficult for him.",
      "vi": "Cậu thích các môn học, nhưng tiếng Anh thì khó với cậu."
    },
    {
      "en": "He wants to speak English well.",
      "vi": "Cậu muốn nói tiếng Anh giỏi."
    },
    {
      "en": "So he practises a little every day.",
      "vi": "Vì vậy cậu luyện tập một chút mỗi ngày."
    }
  ],
